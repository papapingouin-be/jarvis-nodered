{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JarvisProject",
  "type": "object",
  "required": ["project_type", "title", "summary", "objective", "scope", "constraints", "inputs", "outputs", "tasks", "tools_needed", "success_criteria", "source"],
  "properties": {
    "project_type": {"const": "project-dev"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "objective": {"type": "string"},
    "scope": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "type": {"type": "string"},
          "tool_needed": {"type": "string"},
          "acceptance": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "tools_needed": {"type": "array", "items": {"type": "string"}},
    "success_criteria": {"type": "array", "items": {"type": "string"}},
    "source": {
      "type": "object",
      "required": ["channel", "conversation_id"],
      "properties": {
        "channel": {"type": "string"},
        "conversation_id": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
