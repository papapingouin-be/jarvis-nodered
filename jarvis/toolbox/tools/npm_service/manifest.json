{
  "name": "npm_service",
  "description": "Gestion des services Nginx Proxy Manager et génération de requêtes API",
  "action_types": ["run_tool", "analysis"],
  "entrypoint": "tool.py",
  "input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": ["register_instance", "register_service", "list_services", "plan_service_action"]
      },
      "instance": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "base_url": {"type": "string"},
          "login": {"type": "string"},
          "password": {"type": "string"},
          "password_secret_key": {"type": "string"}
        },
        "required": ["name", "base_url", "login"]
      },
      "service": {
        "type": "object",
        "properties": {
          "domain": {"type": "string"},
          "instance_name": {"type": "string"},
          "forward_host": {"type": "string"},
          "forward_port": {"type": "integer"},
          "scheme": {"type": "string"}
        },
        "required": ["domain", "instance_name", "forward_host", "forward_port"]
      },
      "instance_name": {"type": "string"},
      "domain": {"type": "string"},
      "action": {"type": "string", "enum": ["list", "add", "delete"]}
    },
    "required": ["operation"],
    "allOf": [
      {"if": {"properties": {"operation": {"const": "register_instance"}}}, "then": {"required": ["instance"]}},
      {"if": {"properties": {"operation": {"const": "register_service"}}}, "then": {"required": ["service"]}},
      {"if": {"properties": {"operation": {"const": "list_services"}}}, "then": {"required": ["instance_name"]}},
      {"if": {"properties": {"operation": {"const": "plan_service_action"}}}, "then": {"required": ["instance_name", "action"]}}
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "operation": {"type": "string"},
      "result": {"type": "object"}
    },
    "required": ["operation", "result"]
  }
}
