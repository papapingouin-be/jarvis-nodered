{
  "name": "npm_service",
  "description": "Gestion des services Nginx Proxy Manager et génération de requêtes API",
  "action_types": [
    "run_tool",
    "analysis"
  ],
  "entrypoint": "tool.py",
  "input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "register_instance",
          "register_service",
          "list_services",
          "plan_service_action",
          "describe"
        ],
        "description": "Legacy alias of intent. Prefer intent."
      },
      "mode": {
        "type": "string",
        "description": "Legacy alias of intent. Prefer intent."
      },
      "instance": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "base_url": {
            "type": "string"
          },
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "password_secret_key": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "base_url",
          "login"
        ]
      },
      "service": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "instance_name": {
            "type": "string"
          },
          "forward_host": {
            "type": "string"
          },
          "forward_port": {
            "type": "integer"
          },
          "scheme": {
            "type": "string"
          }
        },
        "required": [
          "domain",
          "instance_name",
          "forward_host",
          "forward_port"
        ]
      },
      "instance_name": {
        "type": "string"
      },
      "domain": {
        "type": "string"
      },
      "action": {
        "type": "string",
        "enum": [
          "list",
          "add",
          "delete"
        ]
      },
      "intent": {
        "type": "string",
        "enum": [
          "",
          "registry.register_instance",
          "registry.register_service",
          "list.services",
          "plan.service_action",
          "inspect.describe",
          "register_instance",
          "register_service",
          "list_services",
          "list_proxy_services",
          "plan_service_action",
          "describe",
          "lister les services npm",
          "liste les services npm",
          "liste les services",
          "utilise npm_service et liste les services"
        ]
      }
    },
    "required": [
      "intent"
    ],
    "allOf": [
      {
        "if": {
          "required": [
            "intent"
          ],
          "properties": {
            "intent": {
              "enum": [
                "registry.register_instance",
                "register_instance"
              ]
            }
          }
        },
        "then": {
          "required": [
            "instance"
          ]
        }
      },
      {
        "if": {
          "required": [
            "intent"
          ],
          "properties": {
            "intent": {
              "enum": [
                "registry.register_service",
                "register_service"
              ]
            }
          }
        },
        "then": {
          "required": [
            "service"
          ]
        }
      },
      {
        "if": {
          "required": [
            "intent"
          ],
          "properties": {
            "intent": {
              "enum": [
                "list.services",
                "list_services",
                "list_proxy_services",
                "lister les services npm",
                "liste les services npm",
                "liste les services",
                "utilise npm_service et liste les services"
              ]
            }
          }
        }
      },
      {
        "if": {
          "required": [
            "intent"
          ],
          "properties": {
            "intent": {
              "enum": [
                "plan.service_action",
                "plan_service_action"
              ]
            }
          }
        },
        "then": {
          "required": [
            "instance_name",
            "action"
          ]
        }
      }
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "intent": {
        "type": "string"
      },
      "operation": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    },
    "required": [
      "intent",
      "result"
    ]
  },
  "config_requirements": [
    {
      "namespace": "npm_service",
      "key": "JARVIS_INFRA_DB",
      "label": "Chemin complet DB SQLite (path+nomfichier)",
      "required": true
    },
    {
      "namespace": "npm_service",
      "key": "NPM_URL",
      "label": "URL Nginx Proxy Manager",
      "required": false
    },
    {
      "namespace": "npm_service",
      "key": "NPM_IDENTITY",
      "label": "Login NPM",
      "required": false
    },
    {
      "namespace": "npm_service",
      "key": "NPM_SECRET",
      "label": "Mot de passe NPM",
      "required": false
    }
  ]
}
