{
  "name": "proxmox_ct",
  "description": "Gère les CT Proxmox et la résolution de services via une base SQLite",
  "action_types": [
    "run_tool",
    "analysis"
  ],
  "entrypoint": "tool.py",
  "config_requirements": [
    {
      "namespace": "proxmox_ct",
      "key": "JARVIS_INFRA_DB",
      "label": "Chemin complet DB SQLite (path+nomfichier)",
      "required": true
    },
    {
      "namespace": "proxmox",
      "key": "PROXMOX_HOST",
      "label": "Adresse IP / host Proxmox",
      "required": true
    },
    {
      "namespace": "proxmox",
      "key": "PROXMOX_WEB",
      "label": "URL web Proxmox (https://host:8006)",
      "required": false
    },
    {
      "namespace": "proxmox",
      "key": "PROXMOX_USER",
      "label": "Utilisateur API/SSH Proxmox",
      "required": true
    },
    {
      "namespace": "proxmox",
      "key": "PROXMOX_PASSWORD",
      "label": "Mot de passe utilisateur Proxmox",
      "required": false
    },
    {
      "namespace": "proxmox",
      "key": "PROXMOX_SSH_PORT",
      "label": "Port SSH Proxmox",
      "required": false
    },
    {
      "namespace": "proxmox",
      "key": "PROXMOX_API_TOKEN_ID",
      "label": "Identifiant de token API Proxmox",
      "required": false
    },
    {
      "namespace": "proxmox",
      "key": "PROXMOX_API_TOKEN_SECRET",
      "label": "Secret du token API Proxmox",
      "required": false
    },
    {
      "namespace": "proxmox_ct",
      "key": "PROXMOX_SECRET_NAMESPACE",
      "label": "Namespace secrets Proxmox",
      "required": false
    }
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "self-doc",
          "diagnose",
          "collect",
          "preflight-create",
          "create-ct",
          "get-ct-info",
          "stop-ct",
          "destroy-ct",
          "ensure-ct",
          "register_target",
          "register_service",
          "resolve_service",
          "plan_ct_action",
          "list_targets",
          "list_services",
          "describe",
          "registry-doc",
          "list-services",
          "describe-service",
          "validate-service-input"
        ]
      },
      "mode": {
        "type": "string",
        "enum": [
          "self-doc",
          "diagnose",
          "collect",
          "preflight-create",
          "create-ct",
          "get-ct-info",
          "stop-ct",
          "destroy-ct",
          "ensure-ct"
        ]
      },
      "target": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ip": {
            "type": "string"
          },
          "api_path": {
            "type": "string"
          },
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "password_secret_key": {
            "type": "string"
          },
          "node": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "ip",
          "login",
          "node"
        ]
      },
      "service_name": {
        "type": "string"
      },
      "include_secret": {
        "type": "boolean"
      },
      "action": {
        "type": "string",
        "enum": [
          "status",
          "start",
          "stop",
          "restart"
        ]
      },
      "params": {
        "type": "object"
      },
      "meta_service": {
        "type": "string"
      },
      "ctid": {
        "type": "integer"
      },
      "hostname": {
        "type": "string"
      },
      "template": {
        "type": "string"
      },
      "storage": {
        "type": "string"
      },
      "bridge": {
        "type": "string"
      },
      "ssh_target": {
        "type": "string"
      }
    },
    "anyOf": [
      {
        "required": [
          "operation"
        ]
      },
      {
        "required": [
          "mode"
        ]
      }
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "operation": {
              "const": "register_target"
            }
          }
        },
        "then": {
          "required": [
            "target"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "operation": {
              "const": "register_service"
            }
          }
        },
        "then": {
          "required": [
            "service"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "operation": {
              "const": "resolve_service"
            }
          }
        },
        "then": {
          "required": [
            "service_name"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "operation": {
              "const": "plan_ct_action"
            }
          }
        },
        "then": {
          "required": [
            "service_name",
            "action"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "operation": {
              "const": "describe-service"
            }
          }
        },
        "then": {
          "required": [
            "meta_service"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "operation": {
              "const": "validate-service-input"
            }
          }
        },
        "then": {
          "required": [
            "meta_service",
            "params"
          ]
        }
      }
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string"
      },
      "result": {
        "type": "object"
      }
    },
    "required": [
      "operation",
      "result"
    ]
  }
}
