{
  "npm_service": {
    "name": "npm_service",
    "description": "Gestion des services Nginx Proxy Manager et génération de requêtes API",
    "action_types": [
      "run_tool",
      "analysis"
    ],
    "entrypoint": "tool.py",
    "input_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "register_instance",
            "register_service",
            "list_services",
            "plan_service_action"
          ]
        },
        "instance": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "base_url": {
              "type": "string"
            },
            "login": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "password_secret_key": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "base_url",
            "login"
          ]
        },
        "service": {
          "type": "object",
          "properties": {
            "domain": {
              "type": "string"
            },
            "instance_name": {
              "type": "string"
            },
            "forward_host": {
              "type": "string"
            },
            "forward_port": {
              "type": "integer"
            },
            "scheme": {
              "type": "string"
            }
          },
          "required": [
            "domain",
            "instance_name",
            "forward_host",
            "forward_port"
          ]
        },
        "instance_name": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "list",
            "add",
            "delete"
          ]
        }
      },
      "required": [
        "operation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "register_instance"
              }
            }
          },
          "then": {
            "required": [
              "instance"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "register_service"
              }
            }
          },
          "then": {
            "required": [
              "service"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "list_services"
              }
            }
          },
          "then": {
            "required": [
              "instance_name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "plan_service_action"
              }
            }
          },
          "then": {
            "required": [
              "instance_name",
              "action"
            ]
          }
        }
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "operation",
        "result"
      ]
    },
    "tool_root": "/workspace/jarvis-nodered/jarvis/toolbox/tools/npm_service"
  },
  "proxmox_ct": {
    "name": "proxmox_ct",
    "description": "Gère les CT Proxmox et la résolution de services via une base SQLite",
    "action_types": [
      "run_tool",
      "analysis"
    ],
    "entrypoint": "tool.py",
    "input_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "register_target",
            "register_service",
            "resolve_service",
            "plan_ct_action",
            "list_targets",
            "list_services"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "ip": {
              "type": "string"
            },
            "api_path": {
              "type": "string"
            },
            "login": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "password_secret_key": {
              "type": "string"
            },
            "node": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "ip",
            "login",
            "node"
          ]
        },
        "service": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "target_name": {
              "type": "string"
            },
            "ctid": {
              "type": "integer"
            },
            "path": {
              "type": "string"
            }
          }
        },
        "service_name": {
          "type": "string"
        },
        "include_secret": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "enum": [
            "status",
            "start",
            "stop",
            "restart"
          ]
        }
      },
      "required": [
        "operation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "register_target"
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "register_service"
              }
            }
          },
          "then": {
            "required": [
              "service"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "resolve_service"
              }
            }
          },
          "then": {
            "required": [
              "service_name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "plan_ct_action"
              }
            }
          },
          "then": {
            "required": [
              "service_name",
              "action"
            ]
          }
        }
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "operation",
        "result"
      ]
    },
    "tool_root": "/workspace/jarvis-nodered/jarvis/toolbox/tools/proxmox_ct"
  },
  "sensitive_store": {
    "name": "sensitive_store",
    "description": "Stockage SQLite des informations sensibles (login/password/ip, etc.)",
    "action_types": [
      "run_tool",
      "analysis"
    ],
    "entrypoint": "tool.py",
    "input_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "set",
            "get",
            "list",
            "delete"
          ]
        },
        "namespace": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "namespace"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "set"
              }
            }
          },
          "then": {
            "required": [
              "key",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "get"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "delete"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ]
          }
        }
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "operation",
        "result"
      ]
    },
    "tool_root": "/workspace/jarvis-nodered/jarvis/toolbox/tools/sensitive_store"
  },
  "example_echo": {
    "name": "example_echo",
    "description": "Retourne le message fourni",
    "action_types": [
      "analysis",
      "run_tool"
    ],
    "entrypoint": "tool.py",
    "input_schema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "echo": {
          "type": "string"
        }
      },
      "required": [
        "echo"
      ]
    },
    "tool_root": "/workspace/jarvis-nodered/jarvis/toolbox/tools/example_echo"
  }
}