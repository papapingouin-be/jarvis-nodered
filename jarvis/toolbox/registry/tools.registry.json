{
  "example_echo": {
    "name": "example_echo",
    "description": "Retourne le message fourni",
    "action_types": [
      "analysis",
      "run_tool"
    ],
    "entrypoint": "tool.py",
    "input_schema": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "echo": {
          "type": "string"
        }
      },
      "required": [
        "echo"
      ]
    },
    "tool_root": "/workspace/jarvis-nodered/jarvis/toolbox/tools/example_echo"
  },
  "npm_service": {
    "name": "npm_service",
    "description": "Gestion des services Nginx Proxy Manager et génération de requêtes API",
    "action_types": [
      "run_tool",
      "analysis"
    ],
    "entrypoint": "tool.py",
    "input_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "register_instance",
            "register_service",
            "list_services",
            "plan_service_action",
            "describe"
          ]
        },
        "instance": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "base_url": {
              "type": "string"
            },
            "login": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "password_secret_key": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "base_url",
            "login"
          ]
        },
        "service": {
          "type": "object",
          "properties": {
            "domain": {
              "type": "string"
            },
            "instance_name": {
              "type": "string"
            },
            "forward_host": {
              "type": "string"
            },
            "forward_port": {
              "type": "integer"
            },
            "scheme": {
              "type": "string"
            }
          },
          "required": [
            "domain",
            "instance_name",
            "forward_host",
            "forward_port"
          ]
        },
        "instance_name": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "enum": [
            "list",
            "add",
            "delete"
          ]
        }
      },
      "required": [
        "operation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "register_instance"
              }
            }
          },
          "then": {
            "required": [
              "instance"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "register_service"
              }
            }
          },
          "then": {
            "required": [
              "service"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "list_services"
              }
            }
          },
          "then": {
            "required": [
              "instance_name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "plan_service_action"
              }
            }
          },
          "then": {
            "required": [
              "instance_name",
              "action"
            ]
          }
        }
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "operation",
        "result"
      ]
    },
    "config_requirements": [
      {
        "namespace": "npm_service",
        "key": "JARVIS_INFRA_DB",
        "label": "Chemin complet DB SQLite (path+nomfichier)",
        "required": true
      },
      {
        "namespace": "npm_service",
        "key": "NPM_URL",
        "label": "URL Nginx Proxy Manager",
        "required": false
      },
      {
        "namespace": "npm_service",
        "key": "NPM_IDENTITY",
        "label": "Login NPM",
        "required": false
      },
      {
        "namespace": "npm_service",
        "key": "NPM_SECRET",
        "label": "Mot de passe NPM",
        "required": false
      }
    ],
    "tool_root": "/workspace/jarvis-nodered/jarvis/toolbox/tools/npm_service"
  },
  "proxmox_ct": {
    "name": "proxmox_ct",
    "description": "Gère les CT Proxmox et la résolution de services via une base SQLite",
    "action_types": [
      "run_tool",
      "analysis"
    ],
    "entrypoint": "tool.py",
    "config_requirements": [
      {
        "namespace": "proxmox_ct",
        "key": "JARVIS_INFRA_DB",
        "label": "Chemin complet DB SQLite (path+nomfichier)",
        "required": true
      },
      {
        "namespace": "proxmox",
        "key": "PROXMOX_HOST",
        "label": "Adresse IP / host Proxmox",
        "required": true
      },
      {
        "namespace": "proxmox",
        "key": "PROXMOX_WEB",
        "label": "URL web Proxmox (https://host:8006)",
        "required": false
      },
      {
        "namespace": "proxmox",
        "key": "PROXMOX_USER",
        "label": "Utilisateur API/SSH Proxmox",
        "required": true
      },
      {
        "namespace": "proxmox",
        "key": "PROXMOX_PASSWORD",
        "label": "Mot de passe utilisateur Proxmox",
        "required": false
      },
      {
        "namespace": "proxmox",
        "key": "PROXMOX_SSH_PORT",
        "label": "Port SSH Proxmox",
        "required": false
      },
      {
        "namespace": "proxmox",
        "key": "PROXMOX_API_TOKEN_ID",
        "label": "Identifiant de token API Proxmox",
        "required": false
      },
      {
        "namespace": "proxmox",
        "key": "PROXMOX_API_TOKEN_SECRET",
        "label": "Secret du token API Proxmox",
        "required": false
      },
      {
        "namespace": "proxmox_ct",
        "key": "PROXMOX_SECRET_NAMESPACE",
        "label": "Namespace secrets Proxmox",
        "required": false
      }
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "self-doc",
            "diagnose",
            "collect",
            "list-ct",
            "list-templates",
            "preflight-create",
            "create-ct",
            "get-ct-info",
            "stop-ct",
            "destroy-ct",
            "ensure-ct",
            "register_target",
            "register_service",
            "resolve_service",
            "plan_ct_action",
            "list_targets",
            "list_services",
            "describe",
            "registry-doc",
            "list-services",
            "describe-service",
            "validate-service-input"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "self-doc",
            "diagnose",
            "collect",
            "list-ct",
            "list-templates",
            "preflight-create",
            "create-ct",
            "get-ct-info",
            "stop-ct",
            "destroy-ct",
            "ensure-ct"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "ip": {
              "type": "string"
            },
            "api_path": {
              "type": "string"
            },
            "login": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "password_secret_key": {
              "type": "string"
            },
            "node": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "ip",
            "login",
            "node"
          ]
        },
        "service_name": {
          "type": "string"
        },
        "include_secret": {
          "type": "boolean"
        },
        "action": {
          "type": "string",
          "enum": [
            "status",
            "start",
            "stop",
            "restart"
          ]
        },
        "params": {
          "type": "object"
        },
        "meta_service": {
          "type": "string"
        },
        "ctid": {
          "type": "integer"
        },
        "hostname": {
          "type": "string"
        },
        "template": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "bridge": {
          "type": "string"
        },
        "ssh_target": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "operation"
          ]
        },
        {
          "required": [
            "mode"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "register_target"
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "register_service"
              }
            }
          },
          "then": {
            "required": [
              "service"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "resolve_service"
              }
            }
          },
          "then": {
            "required": [
              "service_name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "plan_ct_action"
              }
            }
          },
          "then": {
            "required": [
              "service_name",
              "action"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "describe-service"
              }
            }
          },
          "then": {
            "required": [
              "meta_service"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "validate-service-input"
              }
            }
          },
          "then": {
            "required": [
              "meta_service",
              "params"
            ]
          }
        }
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "operation",
        "result"
      ]
    },
    "tool_root": "/workspace/jarvis-nodered/jarvis/toolbox/tools/proxmox_ct"
  },
  "sensitive_store": {
    "name": "sensitive_store",
    "description": "Stockage SQLite des informations sensibles (login/password/ip, etc.)",
    "action_types": [
      "run_tool",
      "analysis"
    ],
    "entrypoint": "tool.py",
    "input_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "set",
            "get",
            "list",
            "delete",
            "describe"
          ]
        },
        "namespace": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "namespace"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "set"
              }
            }
          },
          "then": {
            "required": [
              "key",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "get"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "delete"
              }
            }
          },
          "then": {
            "required": [
              "key"
            ]
          }
        }
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "operation",
        "result"
      ]
    },
    "config_requirements": [
      {
        "namespace": "sensitive_store",
        "key": "JARVIS_INFRA_DB",
        "label": "Chemin complet DB SQLite (path+nomfichier)",
        "required": true
      }
    ],
    "tool_root": "/workspace/jarvis-nodered/jarvis/toolbox/tools/sensitive_store"
  }
}