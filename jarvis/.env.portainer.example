# Chemin ABSOLU du dépôt sur l'hôte Docker (obligatoire en Portainer)
JARVIS_HOST_ROOT=/srv/jarvis-nodered

# Données persistantes Node-RED et logs (chemins absolus recommandés)
NODERED_DATA_PATH=/srv/jarvis-nodered/.data/nodered
JARVIS_LOGS_PATH=/srv/jarvis-nodered/.data/logs
NODERED_USER=0:0

# Optionnel: observabilité (docker-compose.observability.yml)
LOKI_CONFIG_PATH=/opt/jarvis/jarvis-logs/loki-config.yml
PROMTAIL_CONFIG_PATH=/opt/jarvis/jarvis-logs/promtail-config.yml
LOKI_PORT=3100
GRAFANA_PORT=3011
JARVIS_OBS_NET=jarvis_net
JARVIS_PROXY_NET=jarvis_proxy
GF_SECURITY_ADMIN_USER=jarvis
GF_SECURITY_ADMIN_PASSWORD=change-me
