  {"id":"http_in","type":"http in","z":"tab_ingress","name":"Jarvis Inbound","url":"/jarvis/inbound","method":"post","upload":false,"swaggerDoc":"","wires":[["fn_normalize"]]},
  {"id":"fn_normalize","type":"function","z":"tab_ingress","name":"Normalize JarvisMessage","func":"const b = msg.payload || {};\nmsg.payload = {\n  channel: b.channel || 'openwebui',\n  user_id: b.user_id || 'anonymous',\n  conversation_id: b.conversation_id || `conv-${Date.now()}`,\n  message_id: b.message_id || `msg-${Date.now()}`,\n  text: b.text || '',\n  attachments: b.attachments || [],\n  timestamp: new Date().toISOString(),\n  reply_policy: b.reply_policy || 'same_channel',\n  meta: b.meta || {source:'http', raw:b}\n};\nreturn msg;","outputs":1,"noerr":0,"wires":[["link_to_intent","dbg_ingress"]]},
  {"id":"dbg_ingress","type":"debug","z":"tab_ingress","name":"important ingress","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","wires":[]},
  {"id":"http_resp_ingress","type":"http response","z":"tab_ingress","name":"HTTP Response","statusCode":"200","headers":{},"wires":[]},
  {"id":"link_to_intent","type":"link out","z":"tab_ingress","name":"to intent","mode":"link","links":["link_in_intent"],"x":0,"y":0,"wires":[]},

  {"id":"link_in_intent","type":"link in","z":"tab_intent","name":"from ingress","links":["link_to_intent"],"wires":[["set_classify_url"]]},
  {"id":"set_classify_url","type":"function","z":"tab_intent","name":"Set classify URL","func":"const base = env.get('LLM_ADAPTER_URL') || 'http://llm_adapter:8010';\nmsg.url = `${base}/v1/classify`;\nmsg.headers = {'Content-Type':'application/json'};\nreturn msg;","outputs":1,"noerr":0,"wires":[["http_classify"]]},
  {"id":"http_classify","type":"http request","z":"tab_intent","name":"Call classify","method":"POST","ret":"obj","paytoqs":"ignore","url":"","persist":false,"authType":"","senderr":false,"headers":[],"wires":[["sw_mode","dbg_intent"]]},
  {"id":"sw_mode","type":"switch","z":"tab_intent","name":"Route by mode","property":"payload.mode","propertyType":"msg","rules":[{"t":"eq","v":"project-dev","vt":"str"},{"t":"eq","v":"run_tool","vt":"str"},{"t":"eq","v":"status_query","vt":"str"},{"t":"else"}],"checkall":"true","repair":false,"outputs":4,"wires":[["link_to_dialog"],["link_to_runner"],["link_to_poller"],["fn_unknown_reply"]]},
  {"id":"fn_unknown_reply","type":"function","z":"tab_intent","name":"unknown reply","func":"msg.payload = {ok:false,message:'Intention inconnue, peux-tu préciser ?'}; return msg;","outputs":1,"noerr":0,"wires":[["link_to_ingress_response"]]},
  {"id":"dbg_intent","type":"debug","z":"tab_intent","name":"important intent","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","wires":[]},
  {"id":"link_to_dialog","type":"link out","z":"tab_intent","name":"to dialog","mode":"link","links":["link_in_dialog"],"wires":[]},
  {"id":"link_to_runner","type":"link out","z":"tab_intent","name":"to runner","mode":"link","links":["link_in_runner"],"wires":[]},
  {"id":"link_to_poller","type":"link out","z":"tab_intent","name":"to poller","mode":"link","links":["link_in_poller"],"wires":[]},
  {"id":"link_to_ingress_response","type":"link out","z":"tab_intent","name":"to ingress response","mode":"link","links":["link_in_ingress_response"],"wires":[]},

  {"id":"link_in_ingress_response","type":"link in","z":"tab_ingress","name":"from intent","links":["link_to_ingress_response"],"wires":[["http_resp_ingress"]]},

  {"id":"link_in_dialog","type":"link in","z":"tab_dialog","name":"from intent","links":["link_to_dialog"],"wires":[["fn_project_step"]]},
  {"id":"fn_project_step","type":"function","z":"tab_dialog","name":"Set project step URL","func":"const base = env.get('LLM_ADAPTER_URL') || 'http://llm_adapter:8010';\nmsg.url = `${base}/v1/project_dev/step`;\nmsg.headers = {'Content-Type':'application/json'};\nreturn msg;","wires":[["http_project_step"]]},
  {"id":"http_project_step","type":"http request","z":"tab_dialog","name":"project step","method":"POST","ret":"obj","url":"","wires":[["sw_project_done","dbg_dialog"]]},
  {"id":"sw_project_done","type":"switch","z":"tab_dialog","name":"done?","property":"payload.done","propertyType":"msg","rules":[{"t":"true"},{"t":"else"}],"outputs":2,"wires":[["fn_set_spec","link_to_mapper"],["fn_question","link_to_ingress_response"]]},
  {"id":"fn_set_spec","type":"function","z":"tab_dialog","name":"set jarvis_project_json","func":"msg.jarvis_project_json = msg.payload.jarvis_project_json; msg.payload = msg.jarvis_project_json; return msg;","wires":[[]]},
  {"id":"fn_question","type":"function","z":"tab_dialog","name":"question reply","func":"msg.payload = {ok:true, question: msg.payload.question || 'Merci de préciser'}; return msg;","wires":[[]]},
  {"id":"dbg_dialog","type":"debug","z":"tab_dialog","name":"important dialog","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","wires":[]},
  {"id":"link_to_mapper","type":"link out","z":"tab_dialog","name":"to mapper","mode":"link","links":["link_in_mapper"],"wires":[]},

  {"id":"link_in_mapper","type":"link in","z":"tab_mapper","name":"from dialog","links":["link_to_mapper"],"wires":[["fn_opmapper_url"]]},
  {"id":"fn_opmapper_url","type":"function","z":"tab_mapper","name":"set OP mapper URL","func":"const base = env.get('OPENPROJECT_ADAPTER_URL') || 'http://openproject_adapter:8020';\nmsg.url = `${base}/v1/jarvis/create_project_from_spec`;\nmsg.headers = {'Content-Type':'application/json'};\nmsg.payload = { jarvis_project: msg.payload, source: msg.payload.source || {} };\nreturn msg;","wires":[["http_opmapper"]]},
  {"id":"http_opmapper","type":"http request","z":"tab_mapper","name":"create OP project","method":"POST","ret":"obj","url":"","wires":[["dbg_mapper","fn_mapper_reply","link_to_ingress_response"]]},
  {"id":"fn_mapper_reply","type":"function","z":"tab_mapper","name":"reply summary","func":"msg.payload = {ok:true, message:'Projet OpenProject préparé', details: msg.payload}; return msg;","wires":[[]]},
  {"id":"dbg_mapper","type":"debug","z":"tab_mapper","name":"important opmapper","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","wires":[]},

  {"id":"inject_poller","type":"inject","z":"tab_poller","name":"every 3 min","props":[{"p":"payload"}],"repeat":"180","once":false,"onceDelay":0.1,"topic":"","payload":"{}","payloadType":"json","wires":[["fn_poller_url"]]},
  {"id":"link_in_poller","type":"link in","z":"tab_poller","name":"from intent","links":["link_to_poller"],"wires":[["fn_poller_url"]]},
  {"id":"fn_poller_url","type":"function","z":"tab_poller","name":"set list_ready URL","func":"const base = env.get('OPENPROJECT_ADAPTER_URL') || 'http://openproject_adapter:8020';\nmsg.url = `${base}/v1/jarvis/list_ready_tasks`;\nreturn msg;","wires":[["http_ready"]]},
  {"id":"http_ready","type":"http request","z":"tab_poller","name":"list ready tasks","method":"GET","ret":"obj","url":"","wires":[["fn_to_tasks","dbg_poller"]]},
  {"id":"fn_to_tasks","type":"function","z":"tab_poller","name":"extract tasks","func":"msg.payload = msg.payload.tasks || []; return msg;","wires":[["split_tasks"]]},
  {"id":"split_tasks","type":"split","z":"tab_poller","name":"split tasks","splt":"\n","spltType":"str","arraySplt":1,"arraySpltType":"len","stream":false,"addname":"","wires":[["link_to_runner"]]},
  {"id":"dbg_poller","type":"debug","z":"tab_poller","name":"important poller","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","wires":[]},

  {"id":"link_in_runner","type":"link in","z":"tab_runner","name":"from intent/poller","links":["link_to_runner"],"wires":[["fn_choose_tool"]]},
  {"id":"fn_choose_tool","type":"function","z":"tab_runner","name":"choose tool","func":"const t = msg.payload || {};\nconst map = {run_tool:'example_echo',analysis:'example_echo',create_tool:'example_echo'};\nconst tool = t.jarvis_tool_needed || map[t.jarvis_action_type] || 'example_echo';\nmsg.url = `${env.get('TOOLBOX_RUNNER_URL') || 'http://toolbox_runner:8030'}/v1/run`;\nmsg.headers = {'Content-Type':'application/json'};\nmsg.payload = {tool, input: t.input || {message: t.subject || 'hello'}, context:{project_id:t.project_id, task_id:t.task_id}};\nreturn msg;","wires":[["http_run_tool"]]},
  {"id":"http_run_tool","type":"http request","z":"tab_runner","name":"run tool","method":"POST","ret":"obj","url":"","wires":[["fn_after_run","dbg_runner"]]},
  {"id":"fn_after_run","type":"function","z":"tab_runner","name":"status + logging","func":"msg.log_payload = {timestamp:new Date().toISOString(), module:'toolbox_runner', action:'run_tool', status: msg.payload.ok ? 'ok':'fail', message: msg.payload.message};\nmsg.git_changed = !!msg.payload.ok;\nreturn msg;","wires":[["link_to_log"],["link_to_git"]]},
  {"id":"dbg_runner","type":"debug","z":"tab_runner","name":"important runner","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","wires":[]},
  {"id":"link_to_log","type":"link out","z":"tab_runner","name":"to log","mode":"link","links":["link_in_log"],"wires":[]},
  {"id":"link_to_git","type":"link out","z":"tab_runner","name":"to git","mode":"link","links":["link_in_git"],"wires":[]},

  {"id":"link_in_log","type":"link in","z":"tab_log","name":"from runner","links":["link_to_log"],"wires":[["fn_log_url"]]},
  {"id":"fn_log_url","type":"function","z":"tab_log","name":"set log URL","func":"msg.url = `${env.get('LOG_BRIDGE_URL') || 'http://log_bridge:8050'}/v1/log`;\nmsg.headers = {'Content-Type':'application/json'};\nmsg.payload = msg.log_payload || msg.payload;\nreturn msg;","wires":[["http_log"]]},
  {"id":"http_log","type":"http request","z":"tab_log","name":"post log","method":"POST","ret":"obj","url":"","wires":[["dbg_log"]]},
  {"id":"dbg_log","type":"debug","z":"tab_log","name":"important log","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","wires":[]},

  {"id":"link_in_git","type":"link in","z":"tab_git","name":"from runner","links":["link_to_git"],"wires":[["sw_git_changed"]]},
  {"id":"sw_git_changed","type":"switch","z":"tab_git","name":"git changed?","property":"git_changed","propertyType":"msg","rules":[{"t":"true"}],"outputs":1,"wires":[["fn_git_url"]]},
  {"id":"fn_git_url","type":"function","z":"tab_git","name":"set git URL","func":"msg.url = `${env.get('GIT_BRIDGE_URL') || 'http://git_bridge:8040'}/v1/commit_if_dirty`;\nmsg.headers = {'Content-Type':'application/json'};\nmsg.payload = {repo_path: env.get('REPO_PATH') || '/workspace/jarvis-nodered', branch: 'jarvis/demo/task', message:'[jarvis] demo T1 run_tool'};\nreturn msg;","wires":[["http_git"]]},
  {"id":"http_git","type":"http request","z":"tab_git","name":"commit if dirty","method":"POST","ret":"obj","url":"","wires":[["dbg_git"]]},
  {"id":"dbg_git","type":"debug","z":"tab_git","name":"important git","active":true,"tosidebar":true,"complete":"payload","targetType":"msg","wires":[]}
]
